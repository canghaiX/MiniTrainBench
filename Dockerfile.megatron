ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.01-py3@sha256:a411b86de9ac003ce5db43894ea7920718512bc02c51a521157c0899aac75631

FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/canghaiX/MiniTrainBench
ARG MEGATRON_CORE_VERSION=0.18.2

LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      io.minitrainbench.megatron-core.version="${MEGATRON_CORE_VERSION}"

ENV PIP_CONSTRAINT= \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MINITRAINBENCH_BASE_IMAGE="${BASE_IMAGE}" \
    MINITRAINBENCH_BUILD_REVISION="${VCS_REF}"

RUN --mount=type=secret,id=https_proxy,required=false \
    if [ -f /run/secrets/https_proxy ]; then \
      export HTTPS_PROXY="$(cat /run/secrets/https_proxy)"; \
      export HTTP_PROXY="${HTTPS_PROXY}"; \
      export https_proxy="${HTTPS_PROXY}"; \
      export http_proxy="${HTTPS_PROXY}"; \
    fi; \
    python3 -m pip install \
      "megatron-core[training]==${MEGATRON_CORE_VERSION}" tensorboard

WORKDIR /megatron
CMD ["python3", "-c", "import megatron.core; print('Megatron Core ready')"]
